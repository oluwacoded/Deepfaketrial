modules = ["python-3.12", "postgresql-16"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DeepFaceLive Web"

[[workflows.workflow]]
name = "DeepFaceLive Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["abseil-cpp", "gtest", "hdf5", "iana-etc", "oneDNN", "openssh", "pkg-config", "re2"]

[deployment]
deploymentTarget = "vm"
run = ["python", "web_server.py"]
